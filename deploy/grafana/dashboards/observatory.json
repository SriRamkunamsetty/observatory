  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total Traces Ingested",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "observatory_traces_total", "legendFormat": "Total" }]
    },
    {
      "title": "LLM Failure Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "observatory_failure_rate * 100", "legendFormat": "Failure %" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "title": "P95 Latency (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "observatory_latency_p95_ms", "legendFormat": "p95 ms" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Semantic Centroid Drift",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "observatory_centroid_drift", "legendFormat": "Drift Distance" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.35 }
            ]
          }
        }
      }
    },
    {
      "title": "Latency Population Stability Index (PSI)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "observatory_latency_psi", "legendFormat": "PSI" }]
    },
    {
      "title": "Trace Ingestion Throughput (spans/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(observatory_traces_total[1m])", "legendFormat": "Throughput" }]
    },
    {
      "title": "Failure Trend Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(observatory_failures_total[1m])", "legendFormat": "Failures/sec" }]
    }
  ],
